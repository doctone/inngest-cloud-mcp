{
  "name": "inngest-cloud-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Inngest Cloud REST API — inspect functions, runs, and events in production",
  "type": "module",
  "bin": {
    "inngest-cloud-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean --shims",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "inngest",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doctone/inngest-cloud-mcp.git"
  },
  "homepage": "https://github.com/doctone/inngest-cloud-mcp#readme",
  "bugs": {
    "url": "https://github.com/doctone/inngest-cloud-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
